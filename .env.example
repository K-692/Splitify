# Splitify Firebase Configuration
# Replace these placeholder values with your Firebase Web App configuration from:
# https://console.firebase.google.com/project/splitify-151bd/settings/general

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=splitify-151bd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=splitify-151bd
VITE_FIREBASE_STORAGE_BUCKET=splitify-151bd.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# Optional: set to 'true' to connect to local Firebase Emulators
VITE_USE_FIREBASE_EMULATOR=false
